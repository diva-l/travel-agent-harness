# Never commit a real key. You may also pass --env-file to the CLI.
# Planner backend preset: api (hosted API, default) or vllm (local vLLM server).
# Platform support: api mode runs on any OS; vllm mode requires Linux with an
# NVIDIA GPU (vLLM has no native Windows build) — choosing vllm on Windows
# fails fast at startup with a pointer back to api mode.
# The vllm preset fills in tagged protocol, http://127.0.0.1:8000/v1, the
# travel-planner model name and the sampling defaults below; any explicit
# variable here overrides the preset. See docs/deploy-vllm-server.md.
TRAVEL_HARNESS_PLANNER_MODE=api
TRAVEL_HARNESS_API_KEY=
TRAVEL_HARNESS_BASE_URL=https://api.deepseek.com
TRAVEL_HARNESS_MODEL=deepseek-v4-pro
TRAVEL_HARNESS_MODEL_PROTOCOL=native
# Sampling parameters sent to the planner model. top_k is a vLLM extension and
# is only sent when > 0.
TRAVEL_HARNESS_MODEL_TEMPERATURE=0.1
TRAVEL_HARNESS_MODEL_TOP_P=1.0
TRAVEL_HARNESS_MODEL_TOP_K=0
TRAVEL_HARNESS_MODEL_MAX_OUTPUT_TOKENS=1800
TRAVEL_HARNESS_DB=./travel_harness.db
TRAVEL_HARNESS_MAX_STEPS=13
TRAVEL_HARNESS_MAX_SECONDS=120
TRAVEL_HARNESS_MAX_TOTAL_TOKENS=24000
TRAVEL_HARNESS_MAX_TOOL_CALLS=40
TRAVEL_HARNESS_MODEL_RETRIES=2
TRAVEL_HARNESS_REPEAT_CALL_LIMIT=3
TRAVEL_HARNESS_MAX_TOOL_OUTPUT_CHARS=6000
TRAVEL_HARNESS_REPORT_ENABLED=true
TRAVEL_HARNESS_REPORT_MODEL=deepseek-v4-pro
# TRAVEL_HARNESS_REPORT_BASE_URL=https://api.deepseek.com
# TRAVEL_HARNESS_REPORT_API_KEY=use-the-planner-key-by-default (in vllm mode this
# is always required when the report stage is enabled — it never inherits the
# local planner key)

# Tool data source: demo (default, offline fixtures) or amap (real AMap Web service)
TRAVEL_HARNESS_TOOL_PROVIDER=demo
# TRAVEL_HARNESS_AMAP_KEY=

# Web retrieval for search/visit: demo (default) or firecrawl (live web).
# Independent of the geo provider — evaluation runs usually combine
# TRAVEL_HARNESS_TOOL_PROVIDER=amap with TRAVEL_HARNESS_SEARCH_PROVIDER=firecrawl.
TRAVEL_HARNESS_SEARCH_PROVIDER=demo
# TRAVEL_HARNESS_FIRECRAWL_KEY=

# Training-environment alignment knobs (recommended ON when evaluating/serving
# the tagged RL planner; all default off). They mirror the RL rollout loop's
# terminal rules and observation distribution:
# TRAVEL_HARNESS_FORCE_ANSWER_AFTER_STEPS=12   # inject the training-side force-answer message at step 12
# TRAVEL_HARNESS_REPEAT_ANSWER_CHANCE=true     # grant one forced-answer chance on a repeated-call loop
# TRAVEL_HARNESS_MAX_TOOL_OUTPUT_CHARS=5000    # tool_response truncation (head+tail, json2md)
# TRAVEL_HARNESS_VISIT_EXTRACTOR=true          # LLM-extract visit pages via the training EXTRACTOR_PROMPT
# TRAVEL_HARNESS_TICKET_SIMULATOR=true         # train/flight via the training-side LLM simulator
# TRAVEL_HARNESS_TRAINING_TOOL_FORMAT=true     # search/visit observations in the training text format
# TRAVEL_HARNESS_CURRENT_DATE=                 # pin the planner prompt date (evaluation only, e.g. 2026-04-15)
# VISIT_EXTRACTOR / TICKET_SIMULATOR need an LLM credential; they reuse
# TRAVEL_HARNESS_REPORT_* by default.

# Web API concurrency: worker threads executing plan tasks in-process.
# TRAVEL_HARNESS_API_WORKERS=2
# Optional API guard: when set, every /api/* route except /api/health requires
# `Authorization: Bearer <token>`. Leave empty for local demo use.
# TRAVEL_HARNESS_API_TOKEN=
